{
  "name": "archer-rust-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "review": "node dist/cli.js",
    "start": "node dist/cli.js serve",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "catalog:passes": "node --import tsx scripts/knowledge/build-pass-catalog.ts",
    "knowledge:prescreen": "node --import tsx scripts/knowledge/prescreen-history.ts",
    "knowledge:publish": "node --import tsx scripts/knowledge/publish.ts",
    "knowledge:export-pairs": "node --import tsx scripts/knowledge/export-pairs.ts",
    "review:blind": "node --import tsx scripts/review/blind.ts",
    "format": "prettier --write src scripts/knowledge scripts/review package.json tsconfig*.json README.md service/SERVICE.md \".github/workflows/*.yml\"",
    "format:check": "prettier --check src scripts/knowledge scripts/review package.json tsconfig*.json README.md service/SERVICE.md \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@sinclair/typebox": "^0.34.41",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
